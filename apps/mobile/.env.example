# Optional browser handoff to the independently hosted, MFA-protected Research Console.
# Leave blank until the new web app is deployed to an approved HTTPS address.
# This is a public URL, NOT an API token or secret.
EXPO_PUBLIC_RESEARCH_CONSOLE_URL=

# Public configuration only; these values are bundled into the application.
# Disabled by default. Enabling selects the server-backed Manila/Mandaluyong
# discovery pilot; it never grants access to private candidates or approval rights.
EXPO_PUBLIC_PILOT_DISCOVERY_ENABLED=false
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# OSRM-compatible routing base URL (before /route/v1/driving/).
# Blank in development: non-commercial OSRM demo, at most 1 request/second.
# Blank in production: in-app routing disabled. Configure an owned/licensed server.
# Do not put private API keys or credentials in this public URL.
EXPO_PUBLIC_OSRM_URL=

# Optional Photon-compatible geocoder for the legacy destination search.
# Blank in development uses Photon demo; blank in release disables this service.
# The new pilot uses the server destination catalogue and does not require Photon.
# Demo URLs are prohibited in release; configure a reviewed owned/licensed service.
EXPO_PUBLIC_PHOTON_URL=

# Public place autocomplete via this project's /functions/v1/place-search proxy.
# Set true only after deploying the function and its shared quota migration.
# LOCATIONIQ_API_TOKEN belongs in Supabase secrets, NEVER in this file/app.
EXPO_PUBLIC_PLACE_SEARCH_ENABLED=false

# Optional: published Parkey discovery records from the viewport RPC.
# Leave BOTH blank to use the attributed, unverified OSM pilot snapshot only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private text reports: require deployed intake, verified-email OTP configuration,
# approved disclosure, tested quotas and scheduled/monitored retention first.
# Enabling this does not grant review or publication rights. Photos stay local.
EXPO_PUBLIC_REPORT_SUBMISSIONS_ENABLED=false

# Android emulator local URL: http://10.0.2.2:54321
# iOS simulator local URL: http://127.0.0.1:54321
# Physical device: your development machine's reachable LAN IP.
# Never put service-role keys, database passwords, or private provider keys here.
# Publishable sb_publishable_ keys and legacy anon-role JWTs only. Never use a
# reviewer/user access token here; reviewer authentication remains in memory.

# Development-only NCR research route. Leave unset in ALL release profiles.
# The default local endpoint exists only in development bundles.
EXPO_PUBLIC_NCR_RESEARCH_URL=

# Build-only release controls, not client authorization or evidence of licensing.
# Record the actual provider terms/review before setting the relevant review flag.
# Default OpenFreeMap styles need no custom-map override. Blank search/routing
# stays disabled. EAS internal/release profiles set PARKEY_RELEASE_BUILD=true.
PARKEY_MAP_PROVIDER_REVIEWED=false
PARKEY_SEARCH_PROVIDER_REVIEWED=false
PARKEY_ROUTING_PROVIDER_REVIEWED=false

# V1 telemetry is locked off in config.ts pending privacy/release review.
# These reserved provider values are currently ignored; configuration is not consent.
# Optional Plausible custom events. BOTH required when collection is approved.
# Public HTTPS ingestion endpoint and registered hostname; never secret API keys.
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
EXPO_PUBLIC_ANALYTICS_DOMAIN=

# Optional public Sentry DSN; blank means no crash initialization/requests.
# JavaScript errors only; native capture is deliberately disabled.
# Never add Sentry auth/upload tokens to public configuration.
EXPO_PUBLIC_SENTRY_DSN=

# Optional public Mapillary client token (never an app secret/user token).
# Register an app at https://www.mapillary.com/dashboard/developers
# See docs/parking-details.md for exposure and restriction limitations.
EXPO_PUBLIC_MAPILLARY_TOKEN=
