div>\n        <ParkeyIconFacebook className=\"absolute left-[18.5px] size-[24px] top-[14.5px]\" />\n      </a>\n      <div className=\"absolute bg-[var(--parkey-border-default,#58405a)] h-px left-[39px] top-[599px] w-[141px]\" data-node-id=\"249:5182\" data-name=\"Divider one\" />\n      <div className=\"-translate-x-1/2 -translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Outfit:Regular'] font-normal h-[40px] justify-center leading-[0] left-[214px] text-[13px] text-[color:var(--parkey-text-secondary,#d9cfde)] text-center top-[598px] w-[58px]\" data-node-id=\"249:5183\">\n        <p className=\"leading-[1.19]\">or</p>\n      </div>\n      <div className=\"absolute bg-[var(--parkey-border-default,#58405a)] h-px left-[249px] top-[599px] w-[140px]\" data-node-id=\"249:5184\" data-name=\"Divider two\" />\n      <a className=\"absolute block cursor-pointer h-[56px] left-[30px] overflow-clip rounded-[16px] top-[699px] w-[368px]\" data-node-id=\"249:5185\" data-name=\"Sign in / Sign in with email\">\n        <div className=\"-translate-x-1/2 -translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Outfit:SemiBold'] font-semibold h-[56px] justify-center leading-[0] left-[184px] text-[#d8d1df] text-[18px] text-center top-[28px] w-[368px]\" data-node-id=\"249:5186\">\n          <p className=\"leading-[1.19]\">Sign in with email</p>\n        </div>\n      </a>\n      <div className=\"-translate-x-full -translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Outfit:Medium'] font-medium h-[38px] justify-center leading-[0] left-[215px] text-[15px] text-[color:var(--parkey-text-secondary,#d9cfde)] text-right top-[797px] w-[142px]\" data-node-id=\"249:5187\">\n        <p className=\"leading-[1.19]\">New to Parkey?</p>\n      </div>\n      <a className=\"-translate-y-1/2 [word-break:break-word] absolute cursor-pointer flex flex-col font-['Outfit:SemiBold'] font-semibold h-[38px] justify-center leading-[0] left-[219px] text-[15px] text-[c