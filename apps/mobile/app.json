{
  "expo": {
    "name": "Parkey",
    "slug": "parkey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkey",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkey.discovery",
      "buildNumber": "2"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.parkey.discovery",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-status-bar", { "style": "light" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#840561",
          "image": "./assets/figma/onboarding/splash-logo@3x.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 155
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parkey uses your location to show nearby parking, save where you parked, and request directions. You can search without sharing your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an optional photo of parking signs to attach to a draft on this device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
