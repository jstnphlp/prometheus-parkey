SELECT DISTINCT ?item ?itemLabel ?coord ?class WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(120.85 14.30)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(121.27 14.86)"^^geo:wktLiteral .
  }
  VALUES ?class { wd:Q33506 wd:Q3918 wd:Q16917 wd:Q11315 wd:Q27686 wd:Q22698 wd:Q483110 wd:Q570116 }
  ?item wdt:P31/wdt:P279* ?class .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,fil". }
} LIMIT 2000
