# Preserve generated snapshot bytes and manifest hashes across platforms.
apps/mobile/src/discovery/osm-pilot.json text eol=lf
apps/mobile/src/discovery/osm-pilot.json.manifest.json text eol=lf
poblacion-places.geojson text eol=lf
data/parking-open-data-review.json text eol=lf
data/parking-open-data-reviewed.json text eol=lf
data/ncr-research/*.json text eol=lf
data/ncr-research/*.csv text eol=lf
# Patch context preserves upstream tabs and blank lines; keep its hash portable.
patches/*.patch text eol=lf -whitespace
data/ncr-research/licenses/*.json text eol=lf
data/ncr-research/licenses/*.txt text eol=lf
data/ncr-research/*.gz -text

# Keep versioned name-evidence hashes stable on Windows and Linux.
data/ncr-enrichment/**/*.json text eol=lf
data/ncr-enrichment/**/*.gz -text
