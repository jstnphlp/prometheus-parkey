{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "PARKEY_RELEASE_BUILD": "true",
        "EXPO_PUBLIC_PILOT_DISCOVERY_ENABLED": "false"
      }
    },
    "pilot-internal": {
      "extends": "preview",
      "env": {
        "PARKEY_RELEASE_BUILD": "true",
        "EXPO_PUBLIC_PILOT_DISCOVERY_ENABLED": "true"
      }
    },
    "pilot-ios-simulator": {
      "extends": "pilot-internal",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "env": {
        "PARKEY_RELEASE_BUILD": "true",
        "EXPO_PUBLIC_PILOT_DISCOVERY_ENABLED": "false"
      }
    },
    "pilot-production": {
      "extends": "production",
      "env": {
        "PARKEY_RELEASE_BUILD": "true",
        "EXPO_PUBLIC_PILOT_DISCOVERY_ENABLED": "true"
      }
    }
  }
}
